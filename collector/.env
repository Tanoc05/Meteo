# ============================================================================
# CONFIGURAZIONE VARIABILI D'AMBIENTE (Collector Microservice)
# ============================================================================

# 1. INDIRIZZO DEI BROKER KAFKA
# In locale (esecuzione diretta su Mac): localhost:9092
# Dentro Docker Compose: kafka:9092
KAFKA_BROKERS=localhost:9092

# 2. IDENTIFICATIVO DEL CLIENT
# Nome identificativo di questo producer registrato su Kafka
KAFKA_CLIENT_ID=weather-pollution-collector

# 3. TOPIC KAFKA DI DESTINAZIONE
# Topic principale per i dati meteo + inquinamento normalizzati
KAFKA_TOPIC_TELEMETRY=weather_pollution.telemetry

# Topic per messaggi di errore o richieste fallite (Dead Letter Queue)
KAFKA_TOPIC_DLQ=weather_pollution.dlq

# 4. FREQUENZA DI AGGIORNAMENTO (POLLING)
# Tempo di attesa in secondi tra un ciclo di raccolta e il successivo
POLL_INTERVAL_SEC=30

# 5. MODALITÀ DI TEST (DRY RUN)
# Se true: preleva i dati dalle API e li stampa a video SENZA inviarli a Kafka
# Se false: invia i dati al broker Kafka reale
DRY_RUN=true

# 6. PERCORSO FILE CITTÀ (Opzionale, default: ./cities.json)
# CITIES_FILE=./cities.json
