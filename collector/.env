# ============================================================================
# CONFIGURAZIONE VARIABILI D'AMBIENTE (Collector + Logstash)
# ============================================================================

# Indirizzo del broker Kafka (usato da Logstash nell'output kafka)
KAFKA_BROKERS=kafka:9092

# Topic Kafka di destinazione
KAFKA_TOPIC_TELEMETRY=weather_pollution.telemetry

# Frequenza di polling in secondi di collector.js
POLL_INTERVAL_SEC=30
